{
  "compilerOptions": {
    // File Layout
    "rootDir": "typescript/ts/",
    "outDir": "typescript/js",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "commonjs",
    "target": "es2019",
    "types": [],
    "forceConsistentCasingInFileNames": true,
    "skipDefaultLibCheck": true,
    "strict": true
  }
}